#!/bin/sh
# Run clang-tidy in the CI container.
#
# Configures CMake with preset ci-clang, then run-clang-tidy -p on src/
# so tidy uses that compile_commands.json (no -extra-arg).
#
# Usage: bin/check-tidy

set -e

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
REPO_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)
cd "$REPO_ROOT"

CLANG_TIDY_VERSION=14
# Keep this image digest in sync with .github/workflows/*.yml.
CI_IMAGE_BASE=datadog/docker-library:dd-trace-cpp-ci-23768e9

in_container() {
    [ -f /.dockerenv ] || [ -n "${KUBERNETES_SERVICE_HOST:-}" ] || \
        [ "${DD_TRACE_CPP_TIDY_IN_CONTAINER:-}" = "1" ]
}

docker_arch() {
    case "$(uname -m)" in
        arm64|aarch64) echo arm64 ;;
        *) echo amd64 ;;
    esac
}

if ! in_container; then
    if ! command -v docker >/dev/null 2>&1; then
        >&2 echo "docker is required to run clang-tidy-$CLANG_TIDY_VERSION."
        exit 1
    fi
    if ! docker info >/dev/null 2>&1; then
        >&2 echo "Docker is not running. Please start Docker."
        exit 1
    fi
    arch=$(docker_arch)
    image="${CI_IMAGE_BASE}-${arch}"
    exec docker run --rm -t \
        --platform "linux/${arch}" \
        -e DD_TRACE_CPP_TIDY_IN_CONTAINER=1 \
        -e BUILD_DIR=.clang-tidy-build \
        -v "$REPO_ROOT:$REPO_ROOT" \
        -w "$REPO_ROOT" \
        "$image" \
        bin/check-tidy
fi

build_dir=${BUILD_DIR:-.clang-tidy-build}
clang_tidy=clang-tidy-$CLANG_TIDY_VERSION
run_clang_tidy=run-clang-tidy-$CLANG_TIDY_VERSION

if ! command -v "$clang_tidy" >/dev/null 2>&1; then
    if [ -f /etc/debian_version ]; then
        apt-get update
        DEBIAN_FRONTEND=noninteractive apt-get install --yes "$clang_tidy"
    else
        >&2 echo "$clang_tidy is required (pinned). Install it in this container."
        exit 1
    fi
fi

if ! command -v "$clang_tidy" >/dev/null 2>&1; then
    >&2 echo "$clang_tidy is not installed."
    exit 1
fi

if ! command -v "$run_clang_tidy" >/dev/null 2>&1; then
    if command -v run-clang-tidy >/dev/null 2>&1; then
        run_clang_tidy=run-clang-tidy
    else
        >&2 echo "$run_clang_tidy is required (pinned)."
        exit 1
    fi
fi

bin/with-toolchain llvm cmake . -B "$build_dir" --preset ci-clang

# Fail fast if BUILD_DIR is not the ci-clang / libc++ database tidy expects.
compiler=$(sed -n 's/^CMAKE_CXX_COMPILER:FILEPATH=//p' "$build_dir/CMakeCache.txt" | head -n 1)
if [ -z "$compiler" ] || ! command -v "$compiler" >/dev/null 2>&1; then
    >&2 echo "CMAKE_CXX_COMPILER is missing from $build_dir/CMakeCache.txt."
    exit 1
fi
case "$compiler" in
    *clang*) ;;
    *)
        >&2 echo "BUILD_DIR was not configured with preset ci-clang; refusing to run tidy."
        >&2 echo "  CMAKE_CXX_COMPILER=$compiler"
        exit 1
        ;;
esac

compiler_major=$("$compiler" -dumpversion | cut -d. -f1)
clang_tidy_major=$("$clang_tidy" --version | sed -n 's/.*version \([0-9][0-9]*\).*/\1/p' | head -n 1)
if [ "$compiler_major" != "$CLANG_TIDY_VERSION" ] || [ "$clang_tidy_major" != "$CLANG_TIDY_VERSION" ]; then
    >&2 echo "clang-tidy and the CMake compiler must both be LLVM $CLANG_TIDY_VERSION."
    >&2 echo "  $compiler: $compiler_major"
    >&2 echo "  $clang_tidy: $clang_tidy_major"
    exit 1
fi

if ! [ -f "$build_dir/compile_commands.json" ]; then
    >&2 echo "$build_dir/compile_commands.json is missing."
    exit 1
fi

python3 - "$build_dir/compile_commands.json" "$REPO_ROOT" <<'PY'
import json, os, sys
db_path, root = sys.argv[1], sys.argv[2]
ok = 0
for ent in json.load(open(db_path)):
    path = ent.get("file") or ""
    if not os.path.isabs(path):
        path = os.path.normpath(os.path.join(ent.get("directory", root), path))
    try:
        rel = os.path.relpath(path, root)
    except ValueError:
        continue
    if not rel.startswith("src/") or not rel.endswith((".c", ".cc", ".cpp", ".cxx")):
        continue
    cmd = ent.get("command") or " ".join(ent.get("arguments") or [])
    if "-stdlib=libc++" not in cmd:
        sys.stderr.write(
            "BUILD_DIR was not configured with preset ci-clang; refusing to run tidy.\n"
            "  missing -stdlib=libc++ in " + rel + "\n"
        )
        sys.exit(1)
    ok += 1
if ok == 0:
    sys.stderr.write("No src/ entries in " + db_path + ".\n")
    sys.exit(1)
PY

if ! echo '#include <string>' | "$compiler" -stdlib=libc++ -x c++ - -fsyntax-only; then
    >&2 echo "libc++ headers are not usable with $compiler; refusing to run tidy."
    exit 1
fi

"$run_clang_tidy" -p "$build_dir" -clang-tidy-binary "$clang_tidy" \
    -header-filter "^$REPO_ROOT/(src|include)/" -quiet "^$REPO_ROOT/src/"
