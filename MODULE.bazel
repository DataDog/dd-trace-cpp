module(
    name = "dd-trace-cpp",
    version = "2.3.1",
)

bazel_dep(name = "abseil-cpp", version = "20260817.0", repo_name = "com_google_absl")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_rs", version = "0.0.112")

rust_toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
rust_toolchains.toolchain(
    edition = "2021",
    version = "1.92.0",
)
use_repo(rust_toolchains, "default_rust_toolchains")
register_toolchains("@default_rust_toolchains//...")

stable_config_crates = use_extension("@rules_rs//rs:extensions.bzl", "crate")
stable_config_crates.from_cargo(
    name = "stable_config_crates",
    cargo_lock = "//rust/stable-config-bazel-deps:Cargo.lock",
    cargo_toml = "//rust/stable-config-bazel-deps:Cargo.toml",
    platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl",
    ],
)
use_repo(stable_config_crates, "stable_config_crates")
